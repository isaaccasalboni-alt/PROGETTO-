# ── OBBLIGATORIO (Instagram Agent) ────────────────────────────────────────────
# Groq API Key - https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# ── OBBLIGATORIO (legacy / opzionale) ─────────────────────────────────────────
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── E-COMMERCE ASSISTANT ──────────────────────────────────────────────────────
# Nome del tuo negozio online
SHOP_NAME=Il Mio Negozio Online
# Valuta utilizzata
SHOP_CURRENCY=EUR

# ── EMAIL (Resend — gratuito, 3000 email/mese) ─────────────────────────────────
# 1. Vai su resend.com → Sign up con la tua Gmail
# 2. Dashboard → API Keys → Create API Key
# 3. Copia la chiave qui sotto (inizia con re_...)
RESEND_API_KEY=re_your_api_key_here

# A chi arriva il post Instagram
EMAIL_TO=tuo@gmail.com

# ── GOOGLE DRIVE ──────────────────────────────────────────────────────────────
# ID della cartella Drive dove salvare i post (dall'URL di Drive: /folders/QUESTO_ID)
GOOGLE_DRIVE_FOLDER_ID=metti_qui_id_cartella_drive
# Il file credentials.json va messo nella cartella del progetto (non nel .env)

# ── SCHEDULER ──────────────────────────────────────────────────────────────────
# Orario esecuzione giornaliera (formato HH:MM, 24h)
DAILY_RUN_TIME=09:00

# Argomento di default (lascia vuoto per auto-generazione)
DEFAULT_TOPIC=

# Lingua dei contenuti
CONTENT_LANGUAGE=italiano
