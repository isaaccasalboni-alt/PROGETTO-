# ── OBBLIGATORIO ───────────────────────────────────────────────────────────────
# Anthropic API Key - https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ── GAMMA (opzionale — senza key funziona in modalità simulazione) ─────────────
# Gamma API Key - https://gamma.app (Settings > API)
GAMMA_API_KEY=your_gamma_api_key_here

# ── NOTIFICHE EMAIL (Gmail) ────────────────────────────────────────────────────
# Il tuo indirizzo Gmail mittente
EMAIL_FROM=tuo@gmail.com
# A chi arriva il post (puoi mettere lo stesso indirizzo)
EMAIL_TO=tuo@gmail.com
# App Password Gmail (NON la password normale):
#   1. Vai su myaccount.google.com > Sicurezza
#   2. Attiva "Verifica in 2 passaggi"
#   3. Cerca "Password per le app" e creane una
EMAIL_APP_PASSWORD=xxxx_xxxx_xxxx_xxxx

# ── NOTIFICHE TELEGRAM (alternativa/aggiuntiva) ────────────────────────────────
# Come creare un bot Telegram:
#   1. Scrivi a @BotFather su Telegram → /newbot
#   2. Copia il token che ti dà
TELEGRAM_BOT_TOKEN=123456789:ABCdef...
# Il tuo Chat ID (scrivi /start a @userinfobot per ottenerlo)
TELEGRAM_CHAT_ID=123456789

# ── SCHEDULER ──────────────────────────────────────────────────────────────────
# Orario esecuzione giornaliera (formato HH:MM, 24h)
DAILY_RUN_TIME=09:00

# Argomento di default (lascia vuoto per auto-generazione)
DEFAULT_TOPIC=

# Lingua dei contenuti
CONTENT_LANGUAGE=italiano
